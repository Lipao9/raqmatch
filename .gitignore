# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Mercado Livre OAuth: the refresh token rotates on every use, so the script
# rewrites this file in place. Never commit it.
.ml-token.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Neon CLI: IDs de projeto/branch, estado por desenvolvedor
.neon

# Transient batch manifest for `npm run mint` — order matters only between an
# export and its apply, never across sessions.
data/mint-batch.json

# Impeccable working evidence (screenshots, review artifacts) — the design.json sidecar IS versioned
.impeccable/review/
.impeccable/mocks/
.impeccable/questions/
