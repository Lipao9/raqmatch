{
  "name": "raqmatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
  "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "scrape": "tsx scripts/scrape.ts",
    "offers": "node --env-file-if-exists=.env.local --import tsx scripts/offers.ts",
    "data:check": "tsx scripts/check-data.ts",
    "mint": "node --env-file-if-exists=.env.local --import tsx scripts/mint.ts",
    "db:up": "docker start fmr-pg || docker run -d --name fmr-pg --restart unless-stopped -e POSTGRES_PASSWORD=dev -e POSTGRES_DB=findmyracquet -p 55432:5432 -v fmr-pg-data:/var/lib/postgresql/data postgres:16-alpine",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:migrate:prod": "node --env-file=.env.production.local node_modules/drizzle-kit/bin.cjs migrate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
}
