# Copy to .env.local and fill in. Never commit .env.local.
#
# Model access. AI_PROVIDER decides where /api/recommend sends model calls:
#   gateway    -> Vercel AI Gateway (same Messages API, provider list price,
#                 spend visible in the Vercel dashboard); needs AI_GATEWAY_API_KEY
#   anthropic  -> Anthropic API directly; needs ANTHROPIC_API_KEY (also the
#                 default when unset, so this is the rollback path)
# Keep both keys configured so flipping AI_PROVIDER is the only change needed.
AI_PROVIDER=anthropic
AI_GATEWAY_API_KEY=vck_...
ANTHROPIC_API_KEY=sk-ant-...

# Canonical origin for canonical tags, hreflang, sitemap and JSON-LD.
# Optional: falls back to VERCEL_PROJECT_PRODUCTION_URL, then localhost.
# Production is set to the apex (no www) in the Vercel dashboard; www and the
# .vercel.app hosts 308 to it, so this value is what the canonical tags claim.
NEXT_PUBLIC_SITE_URL=https://raqmatch.com

# Tennis Warehouse affiliate program (all optional — with none set, outbound
# links stay plain merchant URLs and the affiliate disclosure is hidden).
# Use EITHER:
#   1. a tracking param appended to the merchant URL
AFFILIATE_PARAM=
AFFILIATE_ID=
#   2. or a network wrapper URL, where {url} receives the encoded merchant URL
AFFILIATE_URL_TEMPLATE=

# Brazilian stores. Each is independent and each degrades to a plain, working
# link when unset — a store is never hidden for lack of an affiliate id.
#
# Mercado Livre. `MATT_WORD` is the etiqueta from the affiliate panel, `MATT_TOOL`
# is the numeric id that appears in every link the panel generates.
#
# LEAVE THESE UNSET until a click composed by hand shows up in the ML Métricas
# report. Verified so far: the panel's only generator emits /social/<user>
# profile links and attribution rides on these two params — but whether they are
# honoured on a URL we compose ourselves is UNCONFIRMED. Setting them on a hunch
# would make the site claim rel="sponsored" on links that earn nothing, which is
# a false disclosure. With them unset, ML links go to the plain listing.
MERCADOLIVRE_MATT_WORD=
MERCADOLIVRE_MATT_TOOL=
#
# Amazon Associates BR tag, e.g. raqmatch-20. Composable on any URL including
# search pages, so this alone monetises the whole catalog.
#
# Note the 180-day clock: the account is cancelled without three qualifying
# sales, so do not open it before there is traffic to convert.
AMAZON_ASSOCIATES_TAG=
#
# Shopee mints its own short links through the affiliate Open API, so there is no
# param to set here — a Shopee link only earns when a generated `affiliateUrl`
# exists for that racquet in data/offers.json.

# Mercado Livre API, used only by the offline offer matcher (never in production).
# Create the application at developers.mercadolivre.com.br with:
#   redirect URI  https://raqmatch.com/api/ml/callback   (HTTPS required; localhost is rejected)
#   scopes        read + offline_access
ML_CLIENT_ID=
ML_CLIENT_SECRET=
#
# The refresh token is NOT set here: Mercado Livre rotates it on every refresh,
# so it lives in .ml-token.json (gitignored) which the script rewrites in place.
# access_token lasts 6h; a broken chain means re-authorising in the browser.

# Google AdSense (all optional — with none set, no ad script loads, no slots
# render and no consent banner appears).
#
# These are NEXT_PUBLIC_ because the <ins> element and the loader script run in
# the browser, which means they are INLINED AT BUILD TIME: changing a value in
# the Vercel dashboard does nothing until the next build (`vercel redeploy`).
#
# The publisher id, as shown in AdSense ("ca-pub-…"). Setting this alone enables
# the loader, /ads.txt and the consent banner.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
#
# One ad unit id per placement. A placement with no id renders nothing, so you
# can roll them out one at a time. Create these as "Display" units in AdSense.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_CATALOG=
NEXT_PUBLIC_ADSENSE_SLOT_RACQUET=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS=
#
# /quiz and /privacy never load the ad library at all, regardless of the above —
# see AD_FREE_PREFIXES in src/lib/ads.ts.
#
# Turn Auto Ads OFF in the AdSense dashboard. Left on, Google injects units of its
# own (anchors, vignettes, in-content) into every page that loads the library,
# which overrides the placement choices above everywhere except the routes that
# block the script entirely.

# Google Analytics 4 (optional — with none set, gtag.js never loads).
#
# The measurement id from the GA4 property ("G-…"), NOT the "ca-pub-…" above and
# NOT a GTM "GTM-…" container. Same build-time inlining caveat as the AdSense
# ids: setting it in the Vercel dashboard needs a redeploy to take effect.
#
# Unlike ads, this loads on /quiz and /privacy too — see GoogleAnalytics.tsx.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Address published on the privacy policy for LGPD requests. Defaults to
# contato@raqmatch.com — set up forwarding for it before ads go live, since an
# unreachable contact fails both LGPD art. 18 and AdSense review.
NEXT_PUBLIC_CONTACT_EMAIL=

# Postgres. Optional: without it the app runs exactly as before — analytics
# become no-ops and rate limiting falls back to an in-process counter.
#
# In .env.local this must point at your LOCAL database (`npm run db:up`), never
# at production: dev traffic mixed into real analytics makes the data useless.
DATABASE_URL=postgresql://postgres:dev@localhost:55432/findmyracquet
#
# Production's connection string lives in .env.production.local instead, read
# only by `npm run db:migrate:prod`. Use Neon's DIRECT string there; the app on
# Vercel gets the POOLED one (the "-pooler" host) via the Vercel dashboard.

# Rate limits for /api/recommend (each call costs an Anthropic request).
# Defaults: 10 per IP per hour, 500 globally per day.
RATE_LIMIT_PER_IP=10
RATE_LIMIT_PER_IP_WINDOW_SECONDS=3600
RATE_LIMIT_GLOBAL=500
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=86400
